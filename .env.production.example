# Copy to .env.production on the server; never commit real secrets.
# The application refuses to start in production until required values are set.
NODE_ENV=production
LOAD_DOTENV=0
PUBLIC_URL=https://YOUR-DOMAIN
SITE_OPERATOR=
SUPPORT_EMAIL=
AUTH_DISABLED=0
SESSION_SECRET=
COOKIE_SECURE=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/google/callback
EPRINT_AUTH_ENABLED=0

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=bytedance-seed/seedream-5-0-lite
OPENROUTER_IMAGE_API=1
OPENROUTER_ASPECT_RATIO=1:2
AI_MOCK=0
AI_DISABLED=0
AI_TIMEOUT_MS=90000

DAILY_GEN_LIMIT=100
ACCOUNT_DAILY_GEN_LIMIT=5
IP_DAILY_GEN_LIMIT=20
IP_GEN_LIMIT=10
IP_GEN_WINDOW_MS=600000
MAX_CONCURRENT_GENERATIONS=3

# Set ONLY after checking your reverse proxy's real socket peer and XFF policy.
# An empty value trusts no client-provided forwarding headers.
TRUSTED_PROXY_IPS=
# Docker Compose provides these automatically. Bare Node needs an absolute path.
# GEN_USAGE_FILE=/var/lib/laisee/gen-usage.json
# AI_DISABLE_FILE=/var/lib/laisee/ai-paused

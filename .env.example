# Copy to .env and fill in. NEVER commit .env or real keys.
# cp .env.example .env

# Provider: gemini | openrouter (Sean chose openrouter for this project)
AI_PROVIDER=openrouter

# --- OpenRouter ---
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# If Google models return 403 TOS on your key, try:
# OPENROUTER_MODEL=bytedance-seed/seedream-5-0-lite
# OPENROUTER_ASPECT_RATIO=2:3
# OPENROUTER_IMAGE_API=1

# --- Gemini (alternative) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image

# Force dry-run: never call upstream (frontend will Canvas-fallback)
AI_MOCK=1

# Server port (default 8765)
# PORT=8765

# --- Auth (login gate) ---
# Local/dev bypass (default: login required)
# AUTH_DISABLED=1

# HMAC secret for httpOnly session cookie (required unless AUTH_DISABLED=1)
SESSION_SECRET=

# Google OAuth 2 (authorization code). Leave empty → Google button disabled, no crash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback

# e-print SSO plug-in (not wired until Sean provides specs — see AUTH-SETUP.md)
# EPRINT_AUTH_URL=
# EPRINT_AUTH_ENABLED=0

# COOKIE_SECURE=1   # only on HTTPS

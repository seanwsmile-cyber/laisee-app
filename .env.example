# Local development only. Copy to .env; never commit secrets.
HOST=127.0.0.1
PORT=8765
AUTH_DISABLED=1
AI_MOCK=1
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-image
OPENROUTER_ASPECT_RATIO=9:16
# Alternative model, verify with your own account before use:
# OPENROUTER_MODEL=bytedance-seed/seedream-5-0-lite
# OPENROUTER_ASPECT_RATIO=1:2
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_OPERATOR=
SUPPORT_EMAIL=
DAILY_GEN_LIMIT=100
ACCOUNT_DAILY_GEN_LIMIT=5
IP_DAILY_GEN_LIMIT=20
MAX_CONCURRENT_GENERATIONS=3
# See .env.production.example for mandatory production configuration.
